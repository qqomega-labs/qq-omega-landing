---
import Layout from '../layouts/Layout.astro'
import { cn } from '../lib/utils'
---

<Layout title="404 - Page Not Found | QQ Omega Labs">
  <div class="min-h-screen bg-radial-deep flex items-center justify-center px-4">
    <div class="bg-filigree absolute inset-0 pointer-events-none z-[1]"></div>
    <div class="bg-vignette absolute inset-0 pointer-events-none z-[2]"></div>

    <div class="relative z-10 text-center font-sans">
      <h1 class="text-8xl sm:text-9xl font-bold text-qq-pink mb-4">404</h1>
      <p class="text-xl sm:text-2xl text-qq-text/80 mb-2">Page Not Found</p>
      <p class="text-sm sm:text-base text-qq-text/50 mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class={cn(
          'inline-flex items-center gap-2',
          'px-6 py-3',
          'bg-qq-pink/10 border border-qq-pink/30 rounded-lg',
          'text-qq-text',
          'transition-all',
          'hover:bg-qq-pink/20 hover:scale-105',
        )}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Home
      </a>
    </div>
  </div>
</Layout>
